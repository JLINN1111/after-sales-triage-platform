<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="er" name="工单数据库 ER 图">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;售后报修智能分诊平台 · 数据库 ER 图&lt;/b&gt;&lt;br&gt;首版采用单表 tickets，分诊结果/知识匹配/人工处理均为工单内字段组；知识库与设备台账为外部受控资料（CSV）" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f3a5f;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1040" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ticket" value="&lt;b&gt;tickets（工单）&lt;/b&gt;" style="shape=table;startSize=30;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="360" height="470" as="geometry" />
          <mxCell id="r0" value="&lt;b&gt;字段（分组）&lt;/b&gt;" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;fillColor=#c3d9f0;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="0" width="360" height="30" as="geometry" />
          </mxCell>
          <mxCell id="r1" value="PK  ticket_id  工单编号（系统生成，不重复）" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="30" width="360" height="40" as="geometry" />
          </mxCell>
          <mxCell id="r2" value="① 报修提交：equipment_type / model / code / description / occurred_at / operating_state / shutdown / safety_risk / alarm_code_status / alarm_code / symptom_tags / submitter_note / created_at" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="70" width="360" height="80" as="geometry" />
          </mxCell>
          <mxCell id="r3" value="② 分诊输出：predicted_category / priority / evidence_codes / missing_fields / follow_up_questions / model_version / triaged_at" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="150" width="360" height="70" as="geometry" />
          </mxCell>
          <mxCell id="r4" value="③ 知识匹配：knowledge_ids / reference_knowledge_ids / knowledge_match_level" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="220" width="360" height="60" as="geometry" />
          </mxCell>
          <mxCell id="r5" value="④ 转人工：recommend_human / handoff_reasons" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="280" width="360" height="50" as="geometry" />
          </mxCell>
          <mxCell id="r6" value="⑤ 客服处理：confirmed_category / confirmed_priority / customer_follow_up / action_status / action_type / action_note / action_at / action_by" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="330" width="360" height="90" as="geometry" />
          </mxCell>
          <mxCell id="r7" value="说明：预测值与确认值分列保存，不互相覆盖；是/否/未知三值独立保存，空值不等于否" style="shape=tableRow;html=1;align=left;strokeColor=#6c8ebf;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="ticket">
            <mxGeometry x="0" y="420" width="360" height="50" as="geometry" />
          </mxCell>
        </mxCell>

        <mxCell id="kb" value="&lt;b&gt;knowledge_base（维修知识 CSV）&lt;/b&gt;&lt;br&gt;knowledge_id (PK)&lt;br&gt;brand / equipment_model / controller_system&lt;br&gt;equipment_category / subsystem / alarm_code&lt;br&gt;title / symptoms / summary / source_*&lt;br&gt;&lt;i&gt;外部受控资料，14 条，记录来源&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ledger" value="&lt;b&gt;equipment_ledger（设备台账 CSV）&lt;/b&gt;&lt;br&gt;asset_token (PK)&lt;br&gt;equipment_type / equipment_category&lt;br&gt;brand / equipment_model / controller_system&lt;br&gt;software_version / site_token / service_status&lt;br&gt;&lt;i&gt;用于精确匹配的确认依据&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tax" value="&lt;b&gt;fault_taxonomy（故障词表 JSON）&lt;/b&gt;&lt;br&gt;模块1产物 v0.1，6 类&lt;br&gt;只读展示，不参与分诊判断&lt;br&gt;&lt;i&gt;实际分诊以 V1 五类标签为准&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sample" value="&lt;b&gt;工单样例 CSV（种子数据）&lt;/b&gt;&lt;br&gt;5 条虚构工单&lt;br&gt;import_sample_data.py 导入到 tickets&lt;br&gt;&lt;i&gt;不含真实个人信息&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="300" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="knowledge_ids / reference_knowledge_ids 引用" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="kb" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="equipment_code 确认设备键" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="ledger" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="展示用（非判断依据）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="tax" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="导入生成工单记录" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="sample" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="关系说明：首版为单表设计，工单与分诊/知识/人工处理是 1:1 的字段组关系，不是多张关联表；虚线为对外部 CSV/JSON 资料的引用或导入关系。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1060" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
