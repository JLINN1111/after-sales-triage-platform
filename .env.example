FLASK_DEBUG=1
SECRET_KEY=replace-for-local-development
DATABASE_URL=sqlite:///instance/triage.db
# 生产环境应保留为 true，且使用随机且保密的 SECRET_KEY。
CSRF_ENABLED=true
# 首次创建本地管理员：填写后运行 `python 运行脚本/init_db.py`；真实密码不得提交。
AUTH_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 复制为 .env 后在本机填写；.env 已被 Git 忽略，禁止提交真实密钥。
LLM_ENABLED=false
LLM_ALLOW_EXTERNAL_CALLS=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=12
# 同一工单成功生成客服参考后的等待时间；0 表示关闭本地冷却限制。
LLM_REFERENCE_COOLDOWN_SECONDS=60
