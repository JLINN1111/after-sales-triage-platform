FLASK_DEBUG=1
SECRET_KEY=replace-for-local-development
DATABASE_URL=sqlite:///instance/triage.db
# 生产环境应保留为 true，且使用随机且保密的 SECRET_KEY。
CSRF_ENABLED=true
# 首次创建本地管理员：填写后运行 `python 运行脚本/init_db.py`；真实密码不得提交。
AUTH_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 对话式报修信息采集助手。复制为 .env 后在本机填写；.env 已被 Git 忽略，禁止提交真实密钥。
# 默认关闭；仅在允许向外部模型发送脱敏后的虚构/授权文本时改为 true。
LLM_ENABLED=false
LLM_ALLOW_EXTERNAL_CALLS=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-flash
# 阿里云百炼（Model Studio）使用 OpenAI 兼容地址；请填入所属地域和工作空间对应的完整 base URL。
# 例如：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
LLM_DASHSCOPE_BASE_URL=
LLM_DASHSCOPE_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=12
LLM_MAX_HISTORY_MESSAGES=10
LLM_MAX_OUTPUT_TOKENS=1200
